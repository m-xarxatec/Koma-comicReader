{
  "name": "koma",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.2 <25"
  },
  "scripts": {
    "watch": "tsc -b --watch",
    "dev": "node --watch --env-file=.env server/dist/server.js",
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "start": "node server/dist/server.js",
    "migrate": "node --env-file-if-exists=.env server/dist/scripts/migrate.js",
    "seed": "node --env-file-if-exists=.env server/dist/scripts/seed.js",
    "content:import": "node --env-file-if-exists=.env server/dist/scripts/import-content.js",
    "seed:online": "node --env-file=.env.online server/dist/scripts/seed.js",
    "content:import:online": "node --env-file=.env.online server/dist/scripts/import-content.js",
    "test": "tsc -b && node --test \"server/dist/tests/unit/**/*.test.js\"",
    "test:api": "tsc -b && node --env-file=.env --env-file=.env.test server/dist/scripts/reset-test-db.js && node --env-file=.env --env-file=.env.test --test \"server/dist/tests/api/**/*.test.js\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1160.0",
    "@aws-sdk/s3-request-presigner": "3.1160.0",
    "bcrypt": "6.0.0",
    "cookie-parser": "1.4.7",
    "express": "5.3.0",
    "express-rate-limit": "8.7.2",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "multer": "2.5.0",
    "pg": "8.23.1",
    "stripe": "23.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bcrypt": "6.0.0",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/multer": "2.3.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "typescript": "7.0.2"
  }
}
